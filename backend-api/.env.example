# Server Configuration
PORT=5000
NODE_ENV=production
LOG_LEVEL=info

# Database Configuration (PostgreSQL / Neon)
DB_HOST=your-neon-hostname.tech
DB_PORT=5432
DB_NAME=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=your_database_password
DB_DIALECT=postgres
POOL_MAX=5
POOL_MIN=1
POOL_ACQUIRE=30000
POOL_IDLE=10000

# Filebase / S3 Storage
ACCESS_KEY_ID=your_filebase_access_key
SECRET_ACCESS_KEY=your_filebase_secret_key
REGION=auto
FILEBASE_ENDPOINT=https://s3.filebase.io
FILEBASE_BUCKET_NAME=adaptive-rag

# LLM Providers (OpenRouter / OpenAI)
OPENROUTER_API_KEY=sk-or-v1-...
RAG_ANSWER_MODEL=openai/gpt-4o-mini
REQUEST_ROUTER_MODEL=openai/gpt-4o-mini
GENERAL_CHAT_MODEL=openai/gpt-4o-mini

# Vector Database (Qdrant Cloud)
QDRANT_URL=https://your-cluster-id.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION_NAME=workspace_chunks

# Authentication (Clerk)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Memory (Mem0)
MEM0_API_KEY=m0-...

# Inngest Background Jobs
INNGEST_DEV=0
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key

# Web Extraction (Firecrawl / Jina)
FIRECRAWL_API_KEY=fc-...
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2
WEB_EXTRACTOR_PROVIDER=firecrawl
JINA_API_KEY=jina_...
JINA_READER_URL=https://r.jina.ai

# Widget Authentication
WIDGET_JWT_SECRET=your_secure_jwt_secret_key

# Billing (Razorpay)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# RapidAPI (YouTube Transcripts)
RAPIDAPI_KEY=your_rapidapi_key
RAPIDAPI_HOST=youtube-transcript3.p.rapidapi.com
